# Copy to .env and fill in. Do not commit .env.

# Server
PORT=8080
APP_BASE_URL=http://localhost:8080

# Database (SQLite to start)
DATABASE_URL=file:./gatepass.db

# Admin
ADMIN_DEFAULT_PASSCODE=0000

# Email provider (pick one; example shown for SMTP)
MAIL_FROM="GatePass <host@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# File storage (local to start; object store when hosted)
UPLOAD_DIR=./uploads
FILE_ENCRYPTION_KEY=

# Retention (decide values)
BOOKING_HIDE_HOURS_AFTER_CHECKOUT=24
ID_FILE_DELETE_DAYS=30
