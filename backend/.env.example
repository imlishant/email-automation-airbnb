# Copy to .env and fill in. Do not commit .env.
# Stack and reasoning: ../docs/TECH_STACK.md

# --- Server ---
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
# Comma-separated origins allowed to call the API. Empty = same-origin only.
CORS_ORIGINS=

# --- Database (SQLite, WAL mode) ---
# A file path, not a connection string: the database is in-process.
DATABASE_URL=file:./data/gatepass.db
# Continuous replication of the DB file. Leave blank to disable locally.
LITESTREAM_REPLICA_URL=

# --- Admin auth ---
# Only what a FRESH install starts from, so nobody is locked out on first use.
# The server stores a slow hash and must refuse to stay on this value in
# production. See ../docs/SECURITY.md.
ADMIN_FIRST_RUN_PASSCODE=0000
ADMIN_PASSCODE_LENGTH=4
# Attempt lockout. Mandatory before any public deployment: a 4-digit code is
# 10,000 possibilities and falls in seconds without it.
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300
# 32+ random bytes, base64. Rotate to invalidate every session.
SESSION_SECRET=

# --- Guest links ---
# Signing key for guest tokens. 32+ random bytes, base64.
GUEST_TOKEN_SECRET=
GUEST_TOKEN_BYTES=16

# --- Email ---
MAIL_PROVIDER=resend
MAIL_FROM="GatePass <host@example.com>"
RESEND_API_KEY=
# SMTP fallback, for hosts who want mail from their own domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Providers cap total attachment size. Above this, compress and retry, then
# surface the failure — never send the email without the IDs.
MAIL_MAX_ATTACHMENT_BYTES=10485760

# --- File storage ---
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
# AES-256-GCM key, 32 bytes base64. Never in the repo.
FILE_ENCRYPTION_KEY=
UPLOAD_MAX_BYTES=8388608
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf
# Long edge in pixels; images are resized and EXIF-stripped on the way in.
IMAGE_MAX_EDGE=2000
# S3-compatible (Cloudflare R2) once hosted.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Sync ---
ICAL_POLL_SECONDS=900
ICAL_FETCH_TIMEOUT_MS=10000

# --- Jobs ---
JOBS_TICK_SECONDS=30
# A claim older than this is considered abandoned and re-picked after a crash.
JOBS_CLAIM_TIMEOUT_SECONDS=300
JOBS_MAX_ATTEMPTS=5

# --- Retention ---
# Hiding and deleting are different. These two are settled; the other two are
# still open decisions in ../docs/DECISIONS.md.
BOOKING_HIDE_HOURS_AFTER_CHECKOUT=24
GUEST_LINK_HOURS_AFTER_CHECKOUT=24
# OPEN: exact delete schedule for ID files, and record retention.
ID_FILE_DELETE_DAYS=30
BOOKING_RECORD_RETENTION_DAYS=90

# --- Limits ---
RATE_LIMIT_GUEST_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10
