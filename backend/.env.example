# Copy to .env and fill in. Do not commit .env.
# Stack and reasoning: ../docs/TECH_STACK.md

# --- Server ---
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
# Comma-separated origins allowed to call the API. Empty = same-origin only.
CORS_ORIGINS=

# --- Database (Turso / libSQL) ---
# Render's free tier has no persistent disk, so a local SQLite file would be
# wiped on every deploy. Turso keeps SQLite semantics off-box. See
# ../docs/TECH_STACK.md §2a. Put the Turso database in the same region as the
# Render service — it is the highest-value config choice on this stack.
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=
# For local development you can still point at a file instead:
# DATABASE_URL=file:./data/gatepass.db

# --- Signing in ---
# People sign in with Google; there is no passcode. Create a free OAuth client
# at console.cloud.google.com (APIs & Services -> Credentials -> OAuth client
# ID -> Web application) and add this exact redirect URI:
#     <APP_BASE_URL>/api/auth/google/callback
# Only "openid email profile" is requested: identity, never anyone's mailbox.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Whoever runs this deployment. They approve which addresses may start an
# account, and they inherit any data from before accounts existed.
PLATFORM_OWNER_EMAIL=

# Development only: sign in by typing an address, with no Google app set up.
# Defaults on outside production and is FATAL in production.
# DEV_LOGIN=false

# --- Guest links ---
# Signing key for guest tokens. 32+ random bytes, base64. REQUIRED in production.
# Deliberately separate from SESSION_SECRET: rotating that one logs every admin
# out, and must not also kill guest links already sent. Rotating THIS one does
# kill them; the admin is then handed a fresh link to resend.
GUEST_TOKEN_SECRET=
GUEST_TOKEN_BYTES=16

# --- Email ---
# Each host connects their OWN Gmail from Settings -> Sending email, and the
# app password is encrypted with FILE_ENCRYPTION_KEY before it is stored. The
# SMTP_* values below are only a fallback for a single-host install, or for
# local work; leave them empty on a multi-host deployment.
#
# How a host gets an app password:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Google Account -> Security -> App passwords -> create one for "Mail".
#   3. Paste the 16 characters into Settings -> Sending email.
#
# The tool only ever sends. It never reads a mailbox. See ../docs/SECURITY.md.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
# What the security desk sees. Must match SMTP_USER for Gmail.
MAIL_FROM="Your Name <you@gmail.com>"
# Where a desk's reply goes, if different.
MAIL_REPLY_TO=

# Fallback only, for a host with no Gmail they already use. Needs a verified
# domain, so it cannot send as an arbitrary @gmail.com address.
RESEND_API_KEY=
# Providers cap total attachment size — Gmail allows 25MB. Over this, the send
# is REFUSED with a message naming the problem: never send without the IDs.
MAIL_MAX_ATTACHMENT_BYTES=10485760
# Tests only, against a local sink. Fatal at boot in production: it would send
# identity documents across the network in plaintext.
SMTP_IGNORE_TLS=false

# --- File storage ---
# db     — encrypted in the database (Turso). The production default; no extra account.
# local  — a folder on disk. Development only: Render wipes its disk on restart.
# s3     — optional, S3-compatible bucket (e.g. Cloudflare R2). Not needed.
STORAGE_DRIVER=db
UPLOAD_DIR=./data/uploads
# AES-256-GCM key, 32 bytes base64. Never in the repo.
FILE_ENCRYPTION_KEY=
UPLOAD_MAX_BYTES=8388608
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf
# Long edge in pixels; images are resized and EXIF-stripped on the way in.
IMAGE_MAX_EDGE=2000
# Only for STORAGE_DRIVER=s3. Leave blank otherwise.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Sync ---
ICAL_POLL_SECONDS=900
# Tests only: lets the calendar fetcher reach a loopback address. Fatal at boot
# in production — relaxing it turns a pasted URL into an SSRF.
ICAL_ALLOW_PRIVATE_HOSTS=false
ICAL_FETCH_TIMEOUT_MS=10000

# --- Jobs ---
# Render free has no cron and sleeps after ~15 min idle, so an external free
# scheduler POSTs to /jobs/tick with this secret every 10 minutes. That drives
# the queue AND keeps the instance awake so a guest never meets a cold start.
JOBS_TICK_SECRET=
JOBS_TICK_SECONDS=30
# A claim older than this is considered abandoned and re-picked after a crash.
JOBS_CLAIM_TIMEOUT_SECONDS=300
JOBS_MAX_ATTEMPTS=5

# --- Check-in / check-out times ---
# Values a FRESH install starts from. The live ones are host settings in the
# database, because the Airbnb feed gives dates with no clock time and the
# automation needs a moment. One pair, global to all listings.
DEFAULT_CHECK_IN_TIME=14:00
DEFAULT_CHECK_OUT_TIME=11:00

# --- Retention (settled: one moment, checkout + 24h) ---
# The booking leaves the list, the guest link dies, and the ID files are
# deleted, all at the same instant — measured from the checkout TIME above,
# not from midnight. Consequence, accepted: past this point a booking cannot
# be resent. Raise only ID_FILE_DELETE_HOURS_AFTER_CHECKOUT to buy a grace
# window. See ../docs/DECISIONS.md, "Retention".
BOOKING_HIDE_HOURS_AFTER_CHECKOUT=24
GUEST_LINK_HOURS_AFTER_CHECKOUT=24
ID_FILE_DELETE_HOURS_AFTER_CHECKOUT=24
# Settled: the record goes at the same moment too. Nothing is kept. See
# ../docs/DECISIONS.md, "Retention", for the consequence that was accepted.
PURGE_RECORD_HOURS_AFTER_CHECKOUT=24

# --- Limits ---
RATE_LIMIT_GUEST_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10
